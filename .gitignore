```gitignore
# Compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files
*.db

# Dependencies
.venv/
venv/
env/
node_modules/

# Logs and temp files
*.log
*.tmp
*.temp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
target/
*.class
*.o
*.obj
*.out

# Coverage reports
coverage/
htmlcov/
.coverage

# Cache directories
.mypy_cache/
.pytest_cache/
.cache/

# OS generated files
.DS_Store
Thumbs.db
```